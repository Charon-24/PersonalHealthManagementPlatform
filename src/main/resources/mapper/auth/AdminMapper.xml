<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peace.personalhealthmanagementplatform.module.auth.mapper.AdminMapper">

    <resultMap id="BaseResultMap" type="com.peace.personalhealthmanagementplatform.module.auth.entity.AdminPO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="sex" property="sex"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="role_id" property="roleId"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, real_name, sex, email, avatar, role_id, status, deleted, create_time, update_time
    </sql>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `admin`
        WHERE username = #{username} AND deleted = 0
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `admin`
        WHERE id = #{id} AND deleted = 0
    </select>

    <select id="selectRoleKeyByRoleId" resultType="java.lang.String">
        SELECT role_key FROM `role` WHERE id = #{roleId}
    </select>

</mapper>
